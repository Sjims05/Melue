{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melue",
  "version": "0.5.16",
  "identifier": "com.simon.melue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../../tauri-plugin-native-audio/src"]
  },
  "app": {
    "windows": [
      {
        "title": "Melue",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["melue"] },
      "mobile": [{ "scheme": ["melue"], "appLink": false }]
    },
    "native-audio": {
      "carSupport": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
