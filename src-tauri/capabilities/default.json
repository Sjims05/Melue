{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, on every platform, and the tray's player (desktop: tray.rs)",
  "windows": [
    "main",
    "tray"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    "fs:default",
    "native-audio:default"
  ]
}
